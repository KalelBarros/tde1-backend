# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# Este arquivo (.env.example) NÃO contém informações sensíveis reais.

# String de conexão do banco de dados relacional (SQLite por padrão)
DATABASE_URL=sqlite:///database.db

# Chave secreta usada para assinar os tokens JWT (utilize um valor forte e aleatório em produção)
JWT_SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte

# Tempo de expiração do token JWT, em minutos
JWT_EXPIRATION_MINUTES=60

# Modo debug do Flask (True/False)
FLASK_DEBUG=True

# Porta em que a API será executada
PORT=5000
